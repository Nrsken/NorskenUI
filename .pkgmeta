package-as: NorskenUI
enable-nolib-creation: no

curse-id: 1460316
wago-id: 96ELgPNg

required-dependencies:
    - norskencore

optional-dependencies:
    - norskenauras

# one project, several addon folders: each module folder ships as its own top-level folder in the zip
move-folders:
    NorskenUI/NorskenUI_UnitFrames: NorskenUI_UnitFrames
    NorskenUI/NorskenUI_Skinning: NorskenUI_Skinning
    NorskenUI/NorskenUI_QoL: NorskenUI_QoL
    NorskenUI/NorskenUI_Options: NorskenUI_Options

# the shared libraries ship with NorskenCore
externals:
    Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    Libs/LibDataBroker-1.1:
        url: https://github.com/tekkub/libdatabroker-1-1
        tag: master
    Libs/LibDualSpec-1.0:
        url: https://github.com/AdiAddons/LibDualSpec-1.0.git
        branch: master

ignore:
    - README.md
    - .git/
    - .github/
    - .vscode/
    - .pkgmeta
    - release.sh
    - VERSION
    - .gitignore
    - .gitattributes
    - .Types/
    - .wowluarc.json
    - Docs
