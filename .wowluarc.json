{
    "library": [
        "Libs/"
    ],
    "flavors": [
        "retail"
    ],
    "globals": {
        "read": [
            "NorskenUIDB",
            "BugGrabber",
            "HidingBarAddon",
            "BugSack",
            "_FRAME",
            "_ENG",
            "_G"
        ],
        "write": [
            "NorskenUI",
            "NorskenUF"
        ]
    },
    "hint": {
        "enable": true,
        "parameterNames": false,
        "variableTypes": false,
        "functionReturnTypes": false,
        "forVariableTypes": false,
        "parameterTypes": false,
        "chainedReturnTypes": false
    },
    "codeLens": {
        "enable": true,
        "references": false,
        "implementations": false,
        "overrides": true
    },
    "diagnostics": {
        "disable": [
            "inject-field"
        ]
    }
}